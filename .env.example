NODE_ENV=development
PORT=3000

# Desenvolvimento local (Postgres do docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tedi
DB_PASSWORD=tedi
DB_DATABASE=tedi

# Produção/staging: string de conexão do provedor (Neon, Render...). Tem prioridade sobre DB_*.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# SSL liga sozinho quando DATABASE_URL existe; force com DB_SSL=true|false
# DB_SSL=true

# Origens do front permitidas no CORS, separadas por vírgula. Aceita curinga de subdomínio.
# Padrão quando vazio: http://localhost:5173,http://localhost:4173
# CORS_ORIGINS=https://tedi-front.vercel.app,https://*.vercel.app

# Segredo do JWT — obrigatório. O boot falha se ausente.
# Em desenvolvimento: qualquer string serve (ex.: "dev"). Em produção, gere um valor seguro.
JWT_SECRET=

# Bypass de desenvolvimento: injeta um usuário fake com o role informado.
# Válido apenas com NODE_ENV != production. Em produção é ignorado e gera um aviso no boot.
# Valores aceitos: member | director | coordinator | superadmin
# DEV_FAKE_ROLE=coordinator
