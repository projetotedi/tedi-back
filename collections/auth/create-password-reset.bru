meta {
  name: create-password-reset
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/access/:id/password-reset
  body: none
  auth: none
}

params:path {
  id: 01952ef7-0000-7000-8000-000000000001
}

headers {
  Accept: application/json
}

docs {
  Gera um link de redefinição de senha para a pessoa informada.
  Requer cookie tedi_session com role coordinator ou superadmin.
  Retorna 201 { url, expiresAt }. O campo url inclui o token em texto claro.
  Coordenadora pode gerar para a própria conta (não se aplica OWN_ACCOUNT).
  O link aponta para /reset-password?token=... no front-end.
  Erros possíveis: 401, 403, 404.
}
