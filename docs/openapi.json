{
  "components": {
    "schemas": {
      "AcceptInviteDto": {
        "properties": {
          "email": {
            "example": "alice@example.com",
            "type": "string"
          },
          "name": {
            "example": "Alice Silva",
            "maxLength": 200,
            "type": "string"
          },
          "password": {
            "example": "Senha@123",
            "minLength": 8,
            "type": "string"
          },
          "ra": {
            "example": "a2210001",
            "type": "string"
          },
          "token": {
            "example": "eyJ...",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "AccessResponseDto": {
        "properties": {
          "accessEnabled": {
            "example": true,
            "type": "boolean"
          },
          "email": {
            "example": "alice@example.com",
            "type": "object"
          },
          "id": {
            "example": "01952ef7-0000-7000-8000-000000000001",
            "type": "string"
          },
          "name": {
            "example": "Alice Silva",
            "type": "string"
          },
          "ra": {
            "example": "a2210001",
            "type": "object"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "ra",
          "email",
          "role",
          "accessEnabled"
        ],
        "type": "object"
      },
      "ApiErrorDto": {
        "properties": {
          "details": {
            "items": {
              "$ref": "#/components/schemas/ApiFieldErrorDto"
            },
            "type": "array"
          },
          "error": {
            "example": "BAD_REQUEST",
            "type": "string"
          },
          "message": {
            "example": "Bad request.",
            "type": "string"
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "type": "object"
      },
      "ApiFieldErrorDto": {
        "properties": {
          "field": {
            "description": "Field name in dot-notation",
            "example": "email",
            "type": "string"
          },
          "message": {
            "example": "email must be an email",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "CreateInviteDto": {
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "description": "Role to assign to the invited person. SUPERADMIN is not allowed.",
            "example": "member"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "CreateInviteResponseDto": {
        "properties": {
          "expiresAt": {
            "example": "2026-09-19T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "example": "01952ef7-0000-7000-8000-000000000001",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "nullable": true
          },
          "url": {
            "description": "Full URL for the invite page. Includes the plain-text token — share with care.",
            "example": "https://tedi-front.vercel.app/invite?token=abc123",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "expiresAt",
          "url"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-16T12:00:00.000Z",
            "type": "string"
          },
          "uptimeSeconds": {
            "example": 1234,
            "type": "number"
          }
        },
        "required": [
          "status",
          "database",
          "uptimeSeconds",
          "timestamp"
        ],
        "type": "object"
      },
      "InviteListItemDto": {
        "properties": {
          "createdAt": {
            "example": "2026-09-17T10:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "example": "2026-09-19T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "example": "01952ef7-0000-7000-8000-000000000001",
            "type": "string"
          },
          "personId": {
            "example": "01952ef7-0000-7000-8000-000000000002",
            "nullable": true,
            "type": "object"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "nullable": true
          },
          "status": {
            "description": "Computed invite status",
            "enum": [
              "pending",
              "used",
              "expired",
              "revoked"
            ],
            "example": "pending",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InviteType"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "role",
          "status",
          "expiresAt",
          "createdAt"
        ],
        "type": "object"
      },
      "InviteResponseDto": {
        "properties": {
          "expiresAt": {
            "example": "2026-09-19T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "nullable": true
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InviteType"
              }
            ]
          }
        },
        "required": [
          "type",
          "role",
          "expiresAt"
        ],
        "type": "object"
      },
      "InviteType": {
        "enum": [
          "access",
          "password_reset"
        ],
        "type": "string"
      },
      "LoginDto": {
        "properties": {
          "password": {
            "example": "Senha@123",
            "minLength": 8,
            "type": "string"
          },
          "ra": {
            "description": "Academic Registration (RA)",
            "example": "a2210001",
            "type": "string"
          }
        },
        "required": [
          "ra",
          "password"
        ],
        "type": "object"
      },
      "MeResponseDto": {
        "properties": {
          "email": {
            "example": "alice@example.com",
            "nullable": true,
            "type": "object"
          },
          "id": {
            "example": "01952ef7-0000-7000-8000-000000000001",
            "type": "string"
          },
          "name": {
            "example": "Alice Silva",
            "type": "string"
          },
          "ra": {
            "example": "a2210001",
            "nullable": true,
            "type": "object"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "ra",
          "email",
          "role"
        ],
        "type": "object"
      },
      "PasswordResetResponseDto": {
        "properties": {
          "expiresAt": {
            "example": "2026-09-19T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "description": "Full URL for the password-reset page. Includes the plain-text token.",
            "example": "https://tedi-front.vercel.app/reset-password?token=abc123",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ],
        "type": "object"
      },
      "Role": {
        "enum": [
          "member",
          "director",
          "coordinator",
          "superadmin"
        ],
        "type": "string"
      },
      "UpdateAccessEnabledDto": {
        "properties": {
          "enabled": {
            "example": false,
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "UpdateAccessRoleDto": {
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "example": "coordinator"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
