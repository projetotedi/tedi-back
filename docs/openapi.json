{
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "properties": {
          "details": {
            "items": {
              "$ref": "#/components/schemas/ApiFieldErrorDto"
            },
            "type": "array"
          },
          "error": {
            "example": "BAD_REQUEST",
            "type": "string"
          },
          "message": {
            "example": "Bad request.",
            "type": "string"
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ],
        "type": "object"
      },
      "ApiFieldErrorDto": {
        "properties": {
          "field": {
            "description": "Field name in dot-notation",
            "example": "email",
            "type": "string"
          },
          "message": {
            "example": "email must be an email",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-16T12:00:00.000Z",
            "type": "string"
          },
          "uptimeSeconds": {
            "example": 1234,
            "type": "number"
          }
        },
        "required": [
          "status",
          "database",
          "uptimeSeconds",
          "timestamp"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Documentação da API do projeto TEDI",
    "title": "TEDI API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
