{
  "name": "tedi-back",
  "version": "0.1.0",
  "private": true,
  "description": "TEDI API — NestJS + TypeORM + PostgreSQL",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "yarn migration:run:prod && node dist/main.js",
    "build": "nest build",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "jest --testPathIgnorePatterns=\"$^\" --testRegex=\".*\\.int\\.spec\\.ts$\" --runInBand --passWithNoTests",
    "test:all": "jest --testPathIgnorePatterns=\"$^\"",
    "typeorm:ts": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "yarn typeorm:ts migration:create",
    "migration:run": "yarn typeorm:ts migration:run -d ./src/database/data-source.ts",
    "migration:revert": "yarn typeorm:ts migration:revert -d ./src/database/data-source.ts",
    "migration:show": "yarn typeorm:ts migration:show -d ./src/database/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "nestjs-i18n": "^10.5.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "modules/**/*.ts",
      "shared/**/*.ts",
      "!**/__tests__/**",
      "!**/*.module.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "rootDir": "src",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".int.spec.ts$"
    ],
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.(t|j)s$": "ts-jest"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
